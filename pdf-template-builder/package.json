{
  "name": "@jyothiswarup/pdf-template-builder",
  "version": "0.2.0",
  "description": "React components for visually mapping PDF template fields",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./styles": "./dist/styles.css"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "pdf",
    "template",
    "react",
    "pdf-mapping",
    "pdf-builder",
    "field-mapper"
  ],
  "author": "Jyothiswarup E V",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jyothis-web/pdf-npm-package.git",
    "directory": "pdf-template-builder"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3"
  }
}

