{
  "name": "@jyothiswarup/pdf-template-builder",
  "version": "0.3.1",
  "description": "React drag-and-drop PDF field mapper: upload any PDF, place text fields visually, export a JSON schema to fill it with @jyothiswarup/pdf-template-engine.",
  "keywords": [
    "pdf",
    "react",
    "pdf-template",
    "pdf-editor",
    "pdf-builder",
    "field-mapper",
    "pdf-mapping",
    "drag-and-drop",
    "fill-pdf",
    "pdf-filler",
    "certificate-generator",
    "invoice-generator",
    "template-designer",
    "pdfjs",
    "react-component",
    "typescript"
  ],
  "homepage": "https://jyothis-dev.github.io/pdf-npm-package/",
  "bugs": {
    "url": "https://github.com/jyothis-dev/pdf-npm-package/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jyothis-dev/pdf-npm-package.git",
    "directory": "pdf-template-builder"
  },
  "license": "MIT",
  "author": "Jyothiswarup E V",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./styles": "./dist/styles.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3"
  }
}
