{
  "name": "@jyothiswarup/pdf-template-engine",
  "version": "1.2.0",
  "type": "module",
  "description": "Fill any existing PDF from JSON: place text at x/y coordinates on certificates, invoices and forms. Works in Node.js, the browser and serverless.",
  "keywords": [
    "pdf",
    "pdf-template",
    "fill-pdf",
    "pdf-filler",
    "pdf-generation",
    "pdf-generator",
    "certificate-generator",
    "invoice-generator",
    "pdf-overlay",
    "pdf-text",
    "pdf-lib",
    "coordinates",
    "browser",
    "serverless",
    "nodejs",
    "typescript"
  ],
  "homepage": "https://jyothis-dev.github.io/pdf-npm-package/",
  "bugs": {
    "url": "https://github.com/jyothis-dev/pdf-npm-package/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jyothis-dev/pdf-npm-package.git",
    "directory": "frontend 2"
  },
  "license": "MIT",
  "author": "Jyothiswarup E V",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "browser": {
    "./dist/index.js": "./dist/browser.js",
    "./dist/index.cjs": "./dist/browser.cjs"
  },
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/browser.d.ts",
        "import": "./dist/browser.js",
        "require": "./dist/browser.cjs"
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js",
      "require": "./dist/browser.cjs"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=16"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "tsx test/test.ts",
    "server": "tsx server.ts",
    "server:dev": "tsx watch server.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/cors": "^2.8.17",
    "express": "^4.18.2",
    "multer": "^1.4.5-lts.1",
    "cors": "^2.8.5",
    "tsup": "^8.0.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
